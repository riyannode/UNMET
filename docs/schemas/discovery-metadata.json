{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "chainId",
    "contract",
    "demandId",
    "builder",
    "serviceUrl",
    "evidenceHash",
    "revision",
    "issuedAt",
    "request",
    "targets",
    "signature"
  ],
  "properties": {
    "schemaVersion": {
      "const": "unmet-discovery-v1"
    },
    "chainId": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$",
      "maxLength": 78
    },
    "contract": {
      "type": "string",
      "pattern": "^0x(?!0{40}$)[0-9a-f]{40}$"
    },
    "demandId": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$",
      "maxLength": 78
    },
    "builder": {
      "type": "string",
      "pattern": "^0x(?!0{40}$)[0-9a-f]{40}$"
    },
    "serviceUrl": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "evidenceHash": {
      "type": "string",
      "pattern": "^0x[0-9a-f]{64}$"
    },
    "revision": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$",
      "maxLength": 78
    },
    "issuedAt": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$",
      "maxLength": 78
    },
    "signature": {
      "type": "string",
      "pattern": "^0x(?:[0-9a-f]{2})+$",
      "maxLength": 8194
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "query",
        "contentType",
        "body"
      ],
      "properties": {
        "method": {
          "enum": [
            "GET",
            "POST"
          ]
        },
        "query": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": "string",
              "maxLength": 2048
            }
          }
        },
        "contentType": {
          "enum": [
            "application/json",
            null
          ]
        },
        "body": {
          "anyOf": [
            {
              "type": "object"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "targets": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "network",
          "asset",
          "payTo"
        ],
        "properties": {
          "network": {
            "type": "string",
            "pattern": "^eip155:[1-9][0-9]{0,31}$"
          },
          "asset": {
            "type": "string",
            "pattern": "^0x(?!0{40}$)[0-9a-f]{40}$"
          },
          "payTo": {
            "type": "string",
            "pattern": "^0x(?!0{40}$)[0-9a-f]{40}$"
          }
        }
      }
    }
  }
}
