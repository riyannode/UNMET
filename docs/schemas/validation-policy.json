{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://unmetxyz.my.id/schemas/validation-policy.json",
  "description": "Structural constraints only; see FUTURE_IMPLEMENTATION.md for mandatory semantic and transport validation.",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": "unmet-validation-policy-v2"
    },
    "escrowChainId": {
      "type": "string",
      "pattern": "^[1-9][0-9]*$"
    },
    "escrowContract": {
      "type": "string",
      "pattern": "^0x(?!0{40}$)[0-9a-f]{40}$"
    },
    "profile": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
        },
        "enabled": {
          "type": "boolean"
        },
        "network": {
          "type": "string",
          "pattern": "^eip155:[1-9][0-9]{0,31}$"
        },
        "x402Versions": {
          "type": "array",
          "items": {
            "const": 2
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "schemes": {
          "type": "array",
          "items": {
            "const": "exact"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "assets": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "asset": {
                "type": "string",
                "pattern": "^0x(?!0{40}$)[0-9a-f]{40}$"
              },
              "decimals": {
                "type": "integer",
                "minimum": 0,
                "maximum": 255
              },
              "enabled": {
                "type": "boolean"
              },
              "defaultTransferMethod": {
                "anyOf": [
                  {
                    "enum": [
                      "eip3009",
                      "permit2"
                    ]
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "transferMethods": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "method": {
                      "enum": [
                        "eip3009",
                        "permit2"
                      ]
                    },
                    "enabled": {
                      "type": "boolean"
                    },
                    "paymentFlows": {
                      "type": "array",
                      "items": {
                        "const": "authorization"
                      },
                      "minItems": 1,
                      "uniqueItems": true
                    },
                    "defaultPaymentFlow": {
                      "anyOf": [
                        {
                          "const": "authorization"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "tokenDomain": {
                      "anyOf": [
                        {
                          "type": "object",
                          "properties": {
                            "name": {
                              "type": "string",
                              "minLength": 1
                            },
                            "version": {
                              "type": "string",
                              "minLength": 1
                            }
                          },
                          "required": [
                            "name",
                            "version"
                          ],
                          "additionalProperties": false
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "permit2Contract": {
                      "anyOf": [
                        {
                          "type": "string",
                          "pattern": "^0x(?!0{40}$)[0-9a-f]{40}$"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "settlementSpender": {
                      "anyOf": [
                        {
                          "type": "string",
                          "pattern": "^0x(?!0{40}$)[0-9a-f]{40}$"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    }
                  },
                  "required": [
                    "method",
                    "enabled",
                    "paymentFlows",
                    "defaultPaymentFlow",
                    "tokenDomain",
                    "permit2Contract",
                    "settlementSpender"
                  ],
                  "additionalProperties": false,
                  "allOf": [
                    {
                      "if": {
                        "properties": {
                          "method": {
                            "const": "eip3009"
                          }
                        }
                      },
                      "then": {
                        "properties": {
                          "tokenDomain": {
                            "type": "object"
                          },
                          "permit2Contract": {
                            "type": "null"
                          },
                          "settlementSpender": {
                            "type": "null"
                          }
                        }
                      }
                    },
                    {
                      "if": {
                        "properties": {
                          "method": {
                            "const": "permit2"
                          }
                        }
                      },
                      "then": {
                        "properties": {
                          "tokenDomain": {
                            "type": "null"
                          },
                          "permit2Contract": {
                            "type": "string"
                          },
                          "settlementSpender": {
                            "type": "string"
                          }
                        }
                      }
                    }
                  ]
                },
                "minItems": 1
              }
            },
            "required": [
              "asset",
              "decimals",
              "enabled",
              "defaultTransferMethod",
              "transferMethods"
            ],
            "additionalProperties": false
          },
          "minItems": 1
        },
        "paymentRules": {
          "type": "object",
          "properties": {
            "amountType": {
              "const": "uint256"
            },
            "priceComparison": {
              "const": "same-asset-exact"
            },
            "maxTimeoutSeconds": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "amountType",
            "priceComparison",
            "maxTimeoutSeconds"
          ],
          "additionalProperties": false
        },
        "receiverRules": {
          "type": "object",
          "properties": {
            "mode": {
              "const": "builder-authorized"
            },
            "allowZeroAddress": {
              "const": false
            }
          },
          "required": [
            "mode",
            "allowZeroAddress"
          ],
          "additionalProperties": false
        },
        "facilitator": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
                },
                "url": {
                  "type": "string",
                  "pattern": "^https://"
                }
              },
              "required": [
                "id",
                "url"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "enabled",
        "network",
        "x402Versions",
        "schemes",
        "assets",
        "paymentRules",
        "receiverRules",
        "facilitator"
      ],
      "additionalProperties": false
    },
    "demandPriceAsset": {
      "type": "object",
      "properties": {
        "network": {
          "type": "string",
          "pattern": "^eip155:[1-9][0-9]{0,31}$"
        },
        "asset": {
          "type": "string",
          "pattern": "^0x(?!0{40}$)[0-9a-f]{40}$"
        },
        "decimals": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        }
      },
      "required": [
        "network",
        "asset",
        "decimals"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schemaVersion",
    "escrowChainId",
    "escrowContract",
    "profile",
    "demandPriceAsset"
  ],
  "additionalProperties": false
}
