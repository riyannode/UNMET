# Self-hosted Compose defaults: localhost HTTP, Testnet market, Mainnet x402.
# Fill all blank required fields with YOUR configuration before starting.
SITE_ADDRESS=http://localhost
# Alias redirect stays on an unpublished HTTP port for local development.
WWW_SITE_ADDRESS=http://localhost:8081
CANONICAL_ORIGIN=http://localhost
WEB_BIND_IP=127.0.0.1
HTTP_PORT=80
HTTPS_PORT=443
IMAGE_TAG=local
# Change all three together only if this subnet conflicts with an existing network.
APP_SUBNET=172.30.80.0/24
CADDY_INTERNAL_IP=172.30.80.2
API_INTERNAL_IP=172.30.80.3

CHAIN_ID=1952
XLAYER_RPC_URL=https://testrpc.xlayer.tech/terigon
PAYMENT_TOKEN=0x9e29b3aada05bf2d2c827af80bd28dc0b9b4fb0c
DEMAND_CONTRACT=
DEMAND_DEPLOY_BLOCK=0

# Compose always uses production runtime and internal port 8787.
# These also configure a standalone Bun process.
PORT=8787
NODE_ENV=production
FRONTEND_ORIGIN=http://localhost
UNMET_TREASURY=
OPPORTUNITY_PRICE=0.01
# Independent billing rail. Production requires 196, even for a Testnet market.
X402_CHAIN_ID=196
# Mainnet-only settlement receipt confirmation RPC; independent of market XLAYER_RPC_URL.
X402_RPC_URL=https://rpc.xlayer.tech

# Private runtime inputs; never VITE_* or Docker build arguments.
OKX_API_KEY=
OKX_SECRET_KEY=
OKX_PASSPHRASE=
OKX_PAY_TO=

# Process-local capacity defaults; see docs/SELF_HOSTING.md.
# Standalone Bun trusts no proxy by default. Compose trusts only Caddy's IP.
TRUSTED_PROXIES=
RATE_WINDOW_MS=60000
RATE_DEMANDS=60
RATE_OPPORTUNITIES=20
RATE_MAX_KEYS=10000
MAX_IN_FLIGHT=16
RPC_MAX_IN_FLIGHT=16
RPC_TIMEOUT_MS=5000
UPSTREAM_MAX_BYTES=2097152
INDEX_BATCH_SIZE=4
INDEX_MAX_DEMANDS=10000
INDEX_MAX_LOG_WINDOWS=100
INDEX_BUDGET_MS=15000
INDEX_REFRESH_MS=5000
DEPENDENCY_CACHE_MS=5000
FACILITATOR_TIMEOUT_MS=15000
SHUTDOWN_TIMEOUT_MS=20000

# Public build-time inputs. Rebuild web after changing these.
VITE_XLAYER_RPC_URL=https://testrpc.xlayer.tech/terigon
VITE_CHAIN_ID=1952
VITE_DEMAND_CONTRACT=
VITE_MARKET_SYNC_INTERVAL_MS=60000
VITE_PAYMENT_TOKEN=0x9e29b3aada05bf2d2c827af80bd28dc0b9b4fb0c
VITE_REOWN_PROJECT_ID=

# Contract deployment CLI only: keep keys in a SEPARATE ignored env file.
# DEPLOYER_PRIVATE_KEY is intentionally not passed to either container.
ALLOW_MAINNET_DEPLOY=0

# Required durable storage in Compose (fixed /data/payments.sqlite there).
# For standalone Bun: create this directory with mode 700 before startup.
# Leave PAYMENT_DB_PATH unset on Vercel; local function storage is not durable.
# PAYMENT_DB_PATH=/absolute/private/payment-data/payments.sqlite
PAYMENT_RETENTION_DAYS=30
PAYMENT_MAX_RECORDS=100000
