{
  "openapi": "3.1.0",
  "info": {
    "title": "UNMET Demand API",
    "version": "1.0.0",
    "description": "Public demand reads, unsigned demand preparation and OKX-paid demand intelligence. Machine-readable API resources retain JSON regardless of Accept, including text/markdown. The pinned x402 SDK may return an HTML payment page for POST requests that include both Accept: text/html and a Mozilla browser user agent. POST request bodies are limited to 32 KiB.",
    "x-guidance": "GET /v1/demands is free and returns public demand records including raw specification. POST /v1/demands/prepare is free and returns an unsigned transaction intent; it never spends funds. POST /v1/opportunities returns paid ranked records with score breakdowns, economic signals, and reasoning; send a JSON filter body to choose minimum bounty/supporters, status, sort, and result limit. Send Content-Type: application/json and Accept: application/json. A request without payment returns HTTP 402 with an unsigned x402 v2 challenge in PAYMENT-REQUIRED (base64-encoded JSON). Decode it, choose one listed accept option, obtain explicit user authorization, sign that exact authorization with a compatible wallet, then retry the same POST and body with it in PAYMENT-SIGNATURE. The challenge recipient, network, asset, amount, and validity window are authoritative; do not substitute terms. Never reuse an authorization after an ambiguous result or pay again to bypass a conflict. There is no public operation-status endpoint; ask the operator to investigate an ambiguous operation before acting again. Payment buys demand intelligence only; it does not fund a demand or buy service execution."
  },
  "servers": [{ "url": "/" }],
  "externalDocs": {"description": "API and payment documentation", "url": "https://unmetxyz.my.id/docs"},
  "paths": {
    "/.well-known/api-catalog": {
      "get": {
        "operationId": "apiCatalog",
        "summary": "Read the API catalog",
        "responses": {
          "200": {
            "description": "RFC 9727 API catalog linkset.",
            "content": {
            "application/linkset+json": {
                "schema": { "type": "object", "required": ["linkset"], "properties": { "linkset": { "type": "array", "items": { "type": "object" } } } }
              }
            }
          }
        }
      },
      "head": { "operationId": "apiCatalogHead", "responses": { "200": { "description": "API catalog metadata without a response body.", "headers": { "Link": { "$ref": "#/components/headers/ApiCatalogLink" }, "Content-Type": { "schema": { "type": "string", "const": "application/linkset+json; profile=\"https://www.rfc-editor.org/info/rfc9727\"" } } } } } }
    },
    "/live": {
      "get": { "operationId": "liveness", "summary": "Check process liveness", "responses": { "200": { "description": "The API process is responding.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/LiveResponse" } } } } } }
    },
    "/health": {
      "get": { "operationId": "health", "summary": "Check market dependency health", "responses": { "200": { "description": "Market RPC and configured contract are available.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/HealthResponse" } } } }, "503": { "$ref": "#/components/responses/ServiceUnavailable" } } }
    },
    "/ready": {
      "get": { "operationId": "readiness", "summary": "Check service readiness", "responses": { "200": { "description": "Payment and market dependencies are ready.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/HealthResponse" } } } }, "503": { "$ref": "#/components/responses/ServiceUnavailable" } } }
    },
    "/v1/demands": {
      "get": {
        "operationId": "listDemands",
        "summary": "List public demands",
        "responses": {
          "200": { "description": "Up to 50 public chain-derived demands.", "headers": { "Link": { "$ref": "#/components/headers/DiscoveryLinks" } }, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/DemandsResponse" } } } },
          "429": { "description": "Rate limit exceeded; respect Retry-After before retrying.", "headers": { "Retry-After": { "$ref": "#/components/headers/RetryAfter" }, "Link": { "$ref": "#/components/headers/DiscoveryLinks" } }, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "503": { "$ref": "#/components/responses/ServiceUnavailable" }
        }
      },
      "head": { "operationId": "listDemandsHead", "responses": { "200": { "description": "Demand response metadata without a body.", "headers": { "Link": { "$ref": "#/components/headers/DiscoveryLinks" } } } } }
    },
    "/v1/demands/prepare": {
      "post": {
        "operationId": "prepareDemand",
        "summary": "Prepare an unsigned demand creation transaction",
        "description": "Free, strict UTF-8 JSON with no duplicate or unknown fields. Targets the configured escrow deployment only. Trims description and serializes RFQ v1 using JCS within 2048 UTF-8 bytes. Amounts are decimal integer strings in raw units. Deadline must be at least the current chain timestamp plus 3600 seconds; commitment must meet minCommitment. Does not sign, broadcast, approve tokens or invoke payment. Recheck account, target, deadline, allowance and current contract state before wallet execution; preparation reserves nothing.",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/DemandPrepareInput" } } } },
        "responses": {
          "200": { "description": "Unsigned intent for existing createDemand. No native value.", "headers": { "Link": { "$ref": "#/components/headers/DiscoveryLinks" } }, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/DemandIntent" } } } },
          "400": { "description": "Invalid JSON, specification/version, deployment, economics or deadline.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "413": { "description": "Request exceeds 32 KiB.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "415": { "description": "Use uncompressed application/json encoded as UTF-8.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "429": { "description": "Shared demand quota exceeded.", "headers": { "Retry-After": { "$ref": "#/components/headers/RetryAfter" } }, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "503": { "$ref": "#/components/responses/ServiceUnavailable" }
        }
      }
    },
    "/v1/opportunities": {
      "post": {
        "operationId": "rankOpportunities",
        "summary": "Get paid demand intelligence",
        "x-payment-info": {"price":{"mode":"fixed","currency":"USD","amount":"0.01"},"protocols":[{"x402":{"version":2,"accepts":[{"scheme":"exact","network":"eip155:196","asset":"0x779ded0c9e1022225f8e0630b35a9b54be713736","amount":"10000","extra":{"name":"USD₮0","version":"1"}},{"scheme":"exact","network":"eip155:196","asset":"0xb6ceceab302e2e4948951ee7843fc24e92933061","amount":"10000","extra":{"name":"USDC","version":"2"}},{"scheme":"exact","network":"eip155:196","asset":"0x4ae46a509f6b1d9056937ba4500cb143933d2dc8","amount":"10000","extra":{"name":"Global Dollar","version":"1"}}]}}]},
        "description": "Official OKX x402 payment is required. For machine clients, send Accept: application/json. An unpaid request, including a valid empty object, receives HTTP 402 with the challenge in PAYMENT-REQUIRED. The pinned SDK may return an HTML payment page without PAYMENT-REQUIRED when both Accept: text/html and a Mozilla browser user agent are present. Follow the returned JSON challenge and send the authorization in PAYMENT-SIGNATURE. Payment does not fund a demand or buy service execution.",
        "parameters": [
          { "name": "PAYMENT-SIGNATURE", "in": "header", "required": false, "description": "x402 v2 payment authorization. Omit to receive the 402 challenge.", "schema": { "type": "string" } },
          { "name": "Idempotency-Key", "in": "header", "required": false, "description": "Optional with durable SQLite storage; it binds the verified payer, network, and validated operation but does not replay the paid response.", "schema": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[\\x21-\\x7E]{1,128}$" } }
        ],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/OpportunityQuery" } } } },
        "responses": {
          "200": { "description": "Paid ranked analysis.", "headers": { "PAYMENT-RESPONSE": { "description": "Base64-encoded JSON settlement response from the x402 facilitator.", "schema": { "type": "string" } }, "Link": { "$ref": "#/components/headers/DiscoveryLinks" } }, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/OpportunitiesResponse" } } } },
          "400": { "description": "Invalid JSON, filter field, or payment authorization.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "402": { "description": "Payment is required. Machine requests receive the x402 v2 challenge in PAYMENT-REQUIRED and the body may be empty or a JSON object. Browser-like requests with Accept: text/html and a Mozilla user agent may receive an HTML payment page without PAYMENT-REQUIRED.", "headers": { "PAYMENT-REQUIRED": { "description": "Base64-encoded x402 v2 payment requirements; omitted by the SDK browser payment-page branch.", "schema": { "type": "string" } }, "Link": { "$ref": "#/components/headers/DiscoveryLinks" } }, "content": { "application/json": { "schema": { "type": "object" } }, "text/html": { "schema": { "type": "string" } } } },
          "409": { "description": "Payment operation or authorization conflicts with an existing operation. Do not submit another payment to bypass the conflict.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "429": { "description": "Rate limit exceeded before payment verification; respect Retry-After before retrying.", "headers": { "Retry-After": { "$ref": "#/components/headers/RetryAfter" }, "Link": { "$ref": "#/components/headers/DiscoveryLinks" } }, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "413": { "description": "Request body exceeds the 32 KiB limit.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "415": { "description": "Content-Type must be application/json.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "503": { "$ref": "#/components/responses/ServiceUnavailable" }
        }
      }
    },
    "/v1/services": {
      "get": { "operationId": "listServices", "summary": "List up to 50 fulfilled services in descending demand ID order", "responses": { "200": { "description": "Canonical index snapshot", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ServicesResponse" } } } }, "429": { "description": "Shared demand quota exceeded.", "headers": { "Retry-After": { "$ref": "#/components/headers/RetryAfter" } }, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }, "503": { "$ref": "#/components/responses/ServiceUnavailable" } } }
    },
    "/v1/services/{id}": {
      "get": { "operationId": "getService", "summary": "Read a fulfilled service", "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string", "pattern": "^[1-9][0-9]*$" }, "description": "Canonical positive uint256 demand ID" }], "responses": { "200": { "description": "Canonical index snapshot", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ServiceResponse" } } } }, "400": { "description": "Invalid service ID", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }, "404": { "description": "Absent or not fulfilled", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }, "429": { "description": "Shared demand quota exceeded.", "headers": { "Retry-After": { "$ref": "#/components/headers/RetryAfter" } }, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }, "503": { "$ref": "#/components/responses/ServiceUnavailable" } } }
    }
  },
  "components": {
    "headers": {
      "DiscoveryLinks": { "description": "Links to the API catalog, OpenAPI description, and human documentation.", "schema": { "type": "string" } },
      "ApiCatalogLink": { "description": "Identifies the publisher API catalog.", "schema": { "type": "string", "const": "</.well-known/api-catalog>; rel=\"api-catalog\"; type=\"application/linkset+json\"" } },
      "RetryAfter": { "description": "Seconds until retry is appropriate.", "schema": { "type": "integer", "minimum": 1 } }
    },
    "schemas": {
      "Service": { "type": "object", "required": ["demandId", "capability", "specification", "builder", "serviceUrl", "evidenceHash"], "properties": { "demandId": { "type": "string" }, "capability": { "type": "string" }, "specification": { "type": "string", "description": "Raw onchain specification" }, "builder": { "type": "string" }, "serviceUrl": { "type": "string" }, "evidenceHash": { "type": "string" } } },
      "ServiceSnapshot": { "type": "object", "required": ["chainId", "contract", "blockNumber", "blockHash", "generatedAt"], "properties": { "chainId": { "type": "integer" }, "contract": { "type": "string" }, "blockNumber": { "type": "string" }, "blockHash": { "type": "string", "description": "Snapshot block hash, not fulfillment block hash" }, "generatedAt": { "type": "string", "format": "date-time", "description": "Response generation time, not fulfillment time" } } },
      "ServicesResponse": { "allOf": [{ "$ref": "#/components/schemas/ServiceSnapshot" }, { "type": "object", "required": ["services"], "properties": { "services": { "type": "array", "maxItems": 50, "items": { "$ref": "#/components/schemas/Service" } } } }] },
      "ServiceResponse": { "allOf": [{ "$ref": "#/components/schemas/ServiceSnapshot" }, { "type": "object", "required": ["service"], "properties": { "service": { "$ref": "#/components/schemas/Service" } } }] },
      "ErrorResponse": { "type": "object", "required": ["error"], "properties": { "error": { "type": "object", "required": ["code", "message"], "properties": { "code": { "type": "string" }, "message": { "type": "string" } } } } },
      "LiveResponse": { "type": "object", "required": ["ok", "name"], "properties": { "ok": { "const": true }, "name": { "const": "UNMET" } } },
      "HealthResponse": { "type": "object", "required": ["ok", "name", "chainId", "contract", "latestBlock"], "properties": { "ok": { "const": true }, "name": { "const": "UNMET" }, "chainId": { "type": "integer" }, "contract": { "type": "string" }, "latestBlock": { "type": "string" } } },
      "EscrowToken": { "type": "object", "required": ["address", "symbol", "decimals"], "properties": { "address": { "type": "string", "pattern": "^0x[0-9a-fA-F]{40}$" }, "symbol": { "type": "string", "minLength": 1 }, "decimals": { "type": "integer", "minimum": 0, "maximum": 255 } } },
      "OpportunityQuery": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "minBounty": { "type": "string", "pattern": "^[0-9]+(\\.[0-9]+)?$", "default": "0", "description": "Minimum committed amount, decimal units with at most the selected escrow token decimals." },
          "minSupporters": { "type": "integer", "minimum": 0, "maximum": 4294967295, "default": 1 },
          "status": { "type": "string", "pattern": "^(?:[oO][pP][eE][nN]|[sS][uU][bB][mM][iI][tT][tT][eE][dD]|[rR][eE][aA][dD][yY]|[rR][eE][jJ][eE][cC][tT][eE][dD]|[eE][xX][pP][iI][rR][eE][dD]|[fF][uU][lL][fF][iI][lL][lL][eE][dD]|[cC][lL][oO][sS][eE][dD]|[cC][aA][nN][cC][eE][lL][lL][eE][dD])$", "default": "open", "description": "Status comparison is case-insensitive. Omit the property to use the default status filter." },
          "sort": { "type": "string", "enum": ["bounty", "supporters", "calls", "deadline", "score"], "default": "bounty" },
          "limit": { "type": "integer", "minimum": 1, "maximum": 50, "default": 10 }
        }
      },
      "Demand": {
        "type": "object",
        "required": ["demandId", "capability", "currentEscrow", "fundedBounty", "reviewCommitted", "supporters", "expectedCalls", "maxUnitPrice", "deadline", "status", "creator", "builder", "approvalWeight", "approvalRequired", "rejectionWeight", "rejectionThreshold", "candidateRejected", "score"],
        "properties": {
          "demandId": { "type": "string" }, "capability": { "type": "string" }, "currentEscrow": { "type": "string" }, "fundedBounty": { "type": "string" }, "reviewCommitted": { "type": "string" }, "supporters": { "type": "integer" }, "expectedCalls": { "type": "string" }, "maxUnitPrice": { "type": "string", "description": "Maximum Mainnet USDC price per service call, fixed six decimals; network eip155:196, asset 0xb6ceceab302e2e4948951ee7843fc24e92933061. Independent from escrow collateral." }, "deadline": { "type": ["string", "null"], "description": "Serialized ISO 8601 deadline or null when outside the JavaScript date range; extended years are possible." }, "status": { "type": "string" }, "creator": { "type": "string" }, "builder": { "type": "string" }, "approvalWeight": { "type": "string" }, "approvalRequired": { "type": "string" }, "rejectionWeight": { "type": "string" }, "rejectionThreshold": { "type": "string" }, "candidateRejected": { "type": "boolean" }, "score": { "type": "number" }
        }
      },
      "RfqV1": {
        "type": "object", "additionalProperties": false, "required": ["schemaVersion", "description"],
        "properties": { "schemaVersion": { "const": "unmet-rfq-v1" }, "description": { "type": "string", "minLength": 1, "description": "Trimmed before JCS serialization; must remain nonempty and produce an envelope of at most 2048 UTF-8 bytes. No economic fields." } }
      },
      "DemandPrepareInput": {
        "type": "object", "additionalProperties": false,
        "required": ["chainId", "contract", "capability", "specification", "maxUnitPrice", "expectedCalls", "deadline", "initialCommitment"],
        "properties": {
          "chainId": { "type": "integer", "minimum": 1, "maximum": 9007199254740991, "description": "Exact configured escrow chain ID." },
          "contract": { "type": "string", "pattern": "^0x[0-9a-fA-F]{40}$", "description": "Exact configured nonzero escrow contract." },
          "capability": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 64 },
          "specification": { "$ref": "#/components/schemas/RfqV1" },
          "maxUnitPrice": { "type": "string", "pattern": "^[1-9][0-9]*$", "maxLength": 29, "description": "Positive uint96, maximum 79228162514264337593543950335. Raw Mainnet USDC units, 6 decimals; independent from escrow collateral." },
          "expectedCalls": { "type": "string", "pattern": "^[1-9][0-9]*$", "maxLength": 20, "description": "Positive uint64, maximum 18446744073709551615." },
          "deadline": { "type": "string", "pattern": "^[1-9][0-9]*$", "maxLength": 20, "description": "Absolute Unix seconds as uint64, maximum 18446744073709551615. At least current chain timestamp plus 3600." },
          "initialCommitment": { "type": "string", "pattern": "^[1-9][0-9]*$", "maxLength": 29, "description": "Positive uint96, maximum 79228162514264337593543950335. Raw configured escrow-token units, at least current minCommitment. Token decimals are exposed by GET /v1/demands." }
        }
      },
      "DemandIntent": {
        "type": "object", "additionalProperties": false, "required": ["chainId", "to", "data", "value"],
        "properties": { "chainId": { "type": "integer" }, "to": { "type": "string", "pattern": "^0x[0-9a-fA-F]{40}$" }, "data": { "type": "string", "pattern": "^0x[0-9a-fA-F]+$", "description": "Encoded createDemand(capability, specification, maxUnitPrice, expectedCalls, deadline, initialCommitment)." }, "value": { "const": "0" } }
      },
      "PublicDemand": { "allOf": [{ "$ref": "#/components/schemas/Demand" }, { "type": "object", "required": ["specification"], "properties": { "specification": { "type": "string", "description": "Raw onchain specification unchanged, including historical plain text and unknown versions." } } }] },
      "DemandsResponse": {
        "type": "object", "required": ["chainId", "contract", "escrowToken", "blockNumber", "generatedAt", "demands"],
        "properties": { "chainId": { "type": "integer" }, "contract": { "type": "string" }, "escrowToken": { "$ref": "#/components/schemas/EscrowToken" }, "blockNumber": { "type": "string" }, "generatedAt": { "type": "string", "format": "date-time" }, "demands": { "type": "array", "maxItems": 50, "items": { "$ref": "#/components/schemas/PublicDemand" } } }
      },
      "OpportunitiesResponse": {
        "type": "object", "required": ["chainId", "contract", "escrowToken", "blockNumber", "generatedAt", "analysis", "opportunities"],
        "properties": {
          "chainId": { "type": "integer" }, "contract": { "type": "string" }, "escrowToken": { "$ref": "#/components/schemas/EscrowToken" }, "blockNumber": { "type": "string" }, "generatedAt": { "type": "string", "format": "date-time" },
          "analysis": { "type": "object", "required": ["poolSize", "rankingScope", "scoreVersion", "marketToken", "tokenDecimals"], "properties": { "poolSize": { "type": "integer" }, "rankingScope": { "type": "string" }, "scoreVersion": { "type": "string" }, "marketToken": { "type": "string" }, "tokenDecimals": { "type": "integer" } } },
          "opportunities": { "type": "array", "items": { "allOf": [
            { "$ref": "#/components/schemas/Demand" },
            { "type": "object", "required": ["rank", "scoreBreakdown", "economicSignals", "reasoning"], "properties": {
              "rank": { "type": "integer" },
              "scoreBreakdown": { "type": "object", "required": ["funding", "expectedCalls", "supporters", "deadlineFreshness"], "properties": {
                "funding": { "$ref": "#/components/schemas/ScoreFactor" }, "expectedCalls": { "$ref": "#/components/schemas/ScoreFactor" }, "supporters": { "$ref": "#/components/schemas/ScoreFactor" }, "deadlineFreshness": { "type": "object", "required": ["factor", "contribution"], "properties": { "factor": { "type": "number" }, "contribution": { "type": "number" } } }
              } },
              "economicSignals": { "type": "object", "required": ["escrowPerExpectedCall", "timeRemainingSeconds", "review"], "properties": {
                "escrowPerExpectedCall": { "type": ["string", "null"] }, "timeRemainingSeconds": { "type": "string" }, "review": { "type": ["object", "null"], "properties": { "approvalGap": { "type": "string" }, "rejectionHeadroom": { "type": "string" }, "reviewTimeRemainingSeconds": { "type": "string" } } }
              } },
              "reasoning": { "type": "object", "required": ["positive", "cautions"], "properties": { "positive": { "type": "array", "items": { "type": "string" } }, "cautions": { "type": "array", "items": { "type": "string" } } } }
            } }
          ] } }
        }
      },
      "ScoreFactor": { "type": "object", "required": ["percentile", "contribution"], "properties": { "percentile": { "type": "number" }, "contribution": { "type": "number" } } }
    },
    "responses": { "ServiceUnavailable": { "description": "Market or payment service unavailable.", "headers": { "Retry-After": { "$ref": "#/components/headers/RetryAfter" } }, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } } }
  }
}
