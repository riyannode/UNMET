add table bridge unmet_egress
delete table bridge unmet_egress
table bridge unmet_egress {
    comment "UNMET-owned persistent shared web+validator egress"
    set sources4 { type ipv4_addr; elements = { 172.30.80.2, 172.18.0.3 }; }
    set denied4 { type ipv4_addr; flags interval; elements = { 0.0.0.0/8, 10.0.0.0/8, 100.64.0.0/10, 127.0.0.0/8, 169.254.0.0/16, 172.16.0.0/12, 192.0.0.0/24, 192.0.2.0/24, 192.31.196.0/24, 192.52.193.0/24, 192.88.99.0/24, 192.168.0.0/16, 192.175.48.0/24, 198.18.0.0/15, 198.51.100.0/24, 203.0.113.0/24, 224.0.0.0/4, 240.0.0.0/4 }; }
    chain prerouting {
        type filter hook prerouting priority -100; policy accept;
        ether type ip ip saddr @sources4 counter jump egress4 comment "UNMET select only web+validator IPs"
    }
    chain egress4 {
        ct direction reply counter accept comment "UNMET allow ingress replies"
        ct state related counter accept comment "UNMET allow related return traffic"
        ip daddr 172.30.80.3 tcp dport 8787 counter accept comment "UNMET allow API 8787"
        ip daddr 172.18.0.2 tcp dport 3000 counter accept comment "UNMET allow HOROI 3000"
        ip daddr 43.156.68.254 counter drop comment "UNMET deny VPS public management"
        ip daddr @denied4 counter drop comment "UNMET deny private reserved metadata"
        tcp dport 443 counter accept comment "UNMET allow public HTTPS RPC ACME targets"
        counter drop comment "UNMET deny remaining egress"
    }
}
