FROM oven/bun:1.4.2-alpine@sha256:d888c0ae6c86d7866ff10c5aafdd9077b36aee6455b33dd270fb93c0dd5cef6f AS dependencies
WORKDIR /app
COPY package.json bun.lock ./
COPY backend/package.json backend/package.json
COPY frontend/package.json frontend/package.json
RUN bun install --frozen-lockfile --production --filter unmet-backend

FROM oven/bun:1.4.2-alpine@sha256:d888c0ae6c86d7866ff10c5aafdd9077b36aee6455b33dd270fb93c0dd5cef6f AS runtime
WORKDIR /app
ENV NODE_ENV=production
COPY --from=dependencies /app/node_modules ./node_modules
COPY --from=dependencies /app/backend/node_modules ./backend/node_modules
COPY backend/start.ts backend/server.ts backend/contract.ts backend/config.ts backend/admission.ts backend/upstream.ts backend/payment-store.ts backend/payment-error.ts backend/payment-identity.ts backend/payment-confirmation.ts backend/durable-payment.ts backend/payment-ops.ts backend/package.json ./backend/
COPY backend/payment-discovery.ts backend/payment-config.ts ./backend/
COPY frontend/public/openapi.json ./frontend/public/openapi.json
RUN mkdir /data && chown bun:bun /data && chmod 700 /data
USER bun
EXPOSE 8787
CMD ["bun", "run", "backend/start.ts"]
